<view class="page">
  <!-- 顶部招牌 -->
  <view class="hero">
    <view class="hero-name">{{shop.name}}</view>
    <view class="hero-slogan">{{shop.slogan}}</view>
    <view class="hero-hours">🕙 {{shop.hours}}</view>
  </view>

  <!-- 服务项目 -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">服务项目</text>
    </view>
    <view class="service-card">
      <view class="service-row" wx:for="{{services}}" wx:key="name">
        <view>
          <view class="service-name">{{item.name}}</view>
          <view class="service-note">{{item.note}}</view>
        </view>
        <view class="service-price">¥{{item.price}}</view>
      </view>
    </view>
  </view>

  <!-- 精选作品 -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">精选作品</text>
    </view>
    <view class="grid">
      <view class="grid-item" wx:for="{{gallery}}" wx:key="id">
        <view class="thumb">
          <text class="emoji">💇</text>
        </view>
        <view class="grid-title">{{item.title}}</view>
      </view>
    </view>
  </view>
</view>
