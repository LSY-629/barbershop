.hero {
  background: linear-gradient(135deg, #2b2b2b 0%, #3d3d3d 100%);
  border-radius: 20rpx;
  padding: 56rpx 36rpx;
  color: #f5f0e8;
  margin-bottom: 28rpx;
}
.hero-name {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.hero-slogan {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #c8a15a;
}
.hero-hours {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #cccccc;
}

.section {
  margin-bottom: 28rpx;
}
.section-head {
  margin-bottom: 16rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  border-left: 6rpx solid #b8860b;
  padding-left: 16rpx;
}

.service-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.service-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0ede8;
}
.service-row:last-child {
  border-bottom: none;
}
.service-name {
  font-size: 28rpx;
  font-weight: 500;
}
.service-note {
  font-size: 22rpx;
  color: #999999;
  margin-top: 4rpx;
}
.service-price {
  font-size: 30rpx;
  color: #b8860b;
  font-weight: 600;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
}
.grid-item {
  width: 50%;
  padding: 10rpx;
  box-sizing: border-box;
}
.thumb {
  height: 260rpx;
  background: linear-gradient(135deg, #e8e2d8, #d9d2c6);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.emoji {
  font-size: 72rpx;
}
.grid-title {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #555555;
  text-align: center;
}
