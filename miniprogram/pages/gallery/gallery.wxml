<view class="page">
  <view class="tabs">
    <view
      class="tab {{active === item ? 'tab-active' : ''}}"
      wx:for="{{categories}}"
      wx:key="*this"
      data-cat="{{item}}"
      bindtap="onTapCategory"
    >{{item}}</view>
  </view>

  <view class="grid">
    <view class="gallery-card" wx:for="{{list}}" wx:key="id">
      <view class="thumb">
        <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" />
        <view wx:else class="placeholder">
          <text class="emoji">💇</text>
          <text class="cat">{{item.category}}</text>
        </view>
      </view>
      <view class="card-title">{{item.title}}</view>
    </view>
  </view>
</view>
