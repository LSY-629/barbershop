.tabs {
  display: flex;
  margin-bottom: 24rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #666666;
  background: #ffffff;
  border-radius: 12rpx;
  margin: 0 8rpx;
}
.tab:first-child {
  margin-left: 0;
}
.tab:last-child {
  margin-right: 0;
}
.tab-active {
  background: #b8860b;
  color: #ffffff;
  font-weight: 600;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
}
.gallery-card {
  width: 50%;
  box-sizing: border-box;
  padding: 0 10rpx 24rpx;
}
.thumb {
  height: 300rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #e8e2d8, #d9d2c6);
}
.thumb image {
  width: 100%;
  height: 100%;
}
.placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.emoji {
  font-size: 72rpx;
}
.cat {
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
}
.card-title {
  font-size: 24rpx;
  color: #555555;
  margin-top: 12rpx;
  text-align: center;
}
