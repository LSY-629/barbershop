<view class="page">
  <view class="card">
    <view class="card-title">营业时间</view>
    <view class="hours">{{schedule.hours}}</view>
    <view class="closed">{{schedule.closed}}</view>
  </view>

  <view class="card">
    <view class="card-title">理发师排班</view>
    <view class="shift" wx:for="{{schedule.shifts}}" wx:key="name">
      <view class="shift-name">{{item.name}}</view>
      <view class="shift-detail">
        <view>{{item.days}}</view>
        <view>{{item.time}}</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">门店信息</view>
    <view class="row">
      <text class="label">地址</text>
      <text>{{shop.address}}</text>
    </view>
    <view class="row">
      <text class="label">电话</text>
      <text>{{shop.phone}}</text>
    </view>
  </view>
</view>
