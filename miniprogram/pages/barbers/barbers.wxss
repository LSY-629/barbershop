.barber-card {
  display: flex;
  align-items: flex-start;
}
.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #c8a15a, #b8860b);
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.info {
  margin-left: 24rpx;
  flex: 1;
}
.name-row {
  display: flex;
  align-items: baseline;
}
.name {
  font-size: 34rpx;
  font-weight: 700;
}
.title {
  margin-left: 14rpx;
  font-size: 24rpx;
  color: #b8860b;
}
.tags {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
}
.tag {
  font-size: 20rpx;
  color: #7a6a4f;
  background: #f5efe4;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  margin: 0 12rpx 8rpx 0;
}
.desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #777777;
}
.price {
  margin-top: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
}
